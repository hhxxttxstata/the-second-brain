# ============================================================
# Personal Knowledge Agent 配置模板
# 用法: cp .env.example .env  然后填入你的配置
# ============================================================

# ── LLM（必填，任何 OpenAI 兼容接口均可）──
LLM_API_KEY=你的-api-key
LLM_MODEL=你想用的模型名
LLM_BASE_URL=接口地址（如 https://api.example.com/v1）

# ── 你的 Obsidian vault 目录（改成自己的笔记路径；留空/目录为空 = 无 vault 模式）──
# OBSIDIAN_VAULT=D:/path/to/your/vault

# ── 部署模式（可选）──
# APP_ENV=local
